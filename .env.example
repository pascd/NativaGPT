# Copy this file to .env and fill in your own values.
# Never commit your actual .env file - it's already covered by .gitignore.

# API key for the LLM endpoint configured in config/config_default.json
# (llm_config.base_url). The variable name here must match
# llm_config.api_key_env (default: LLM_API_KEY).
#
# - Leave unset / empty if your endpoint doesn't require auth, e.g. a local
#   Ollama server (the default base_url http://localhost:11434/v1).
# - Set it to a real OpenAI API key if you point base_url at
#   https://api.openai.com/v1.
LLM_API_KEY=sk-your-key-here
